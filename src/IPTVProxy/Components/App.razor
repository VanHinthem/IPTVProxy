@using Microsoft.AspNetCore.Components.Web
@using static Microsoft.AspNetCore.Components.Web.RenderMode
<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href="/" />
    <HeadOutlet @rendermode="InteractiveServer" />
    <style>
      body { color: #172033; background: #f8fafc; }
      a { color: #075985; } table { border-collapse: collapse; width: 100%; margin: 1rem 0; background: white; }
      th,td { padding: .3rem .45rem; border-bottom: 1px solid #e2e8f0; text-align: left; overflow-wrap: anywhere; }
      th { background: #eef2f6; } button,input,select { font: inherit; padding: .35rem .5rem; margin: .2rem; }
      button { cursor: pointer; } button:disabled { cursor: default; } label { display: inline-block; margin: .25rem; }
      .chosen-source { background: #e6f5ea; } .muted { color:#526176;font-size:.9rem; } fieldset { border:1px solid #dbe3ed;border-radius:.4rem; } textarea {display:block;width:95%;font:inherit;} small {color:#526176;}
      .summary { display: flex; flex-wrap: wrap; gap: .75rem; } .summary span { background: white; border: 1px solid #dbe3ed; padding: .75rem; border-radius: .4rem; }
    </style>
</head>
<body style="font-family:system-ui;margin:2rem;max-width:100rem">
    <Routes @rendermode="InteractiveServer" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>
</html>
