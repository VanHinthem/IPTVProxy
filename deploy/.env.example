# Copy to .env locally; never commit real credentials.
IPTVPROXY_IMAGE=
BIND_ADDRESS=127.0.0.1
HOST_PORT=5089
PUBLIC_BASE_URL=http://localhost:5089
ADMIN_NAME=admin
ADMIN_PASSWORD=
IPTV_NAME=viewer
IPTV_PASSWORD=

# Configure actual reverse-proxy peer IP(s) and LAN CIDRs before enabling local-only access.
TRUSTED_PROXIES=
LOCAL_NETWORKS=127.0.0.0/8,::1/128
RESTRICT_ADMIN=false
